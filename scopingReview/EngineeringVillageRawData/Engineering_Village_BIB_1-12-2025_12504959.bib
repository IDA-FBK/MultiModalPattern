copyright = {Compendex},
title = {T2KG: Transforming Multimodal Document to Knowledge Graph},
journal = {International Conference Recent Advances in Natural Language Processing, RANLP},
author = {Galiano, Santiago and Munoz, Rafael and Gutierrez, Yoan and Montoyo, Andres and Abreu, Jose I. and Urena, L. Alfonso},
year = {2023},
pages = {385 - 391},
issn = {13138502},
address = {Varna, Bulgaria},
abstract = {<div data-language="eng" data-ev-field="abstract">The large amount of textual information, in digital format available today, makes the knowledge extraction task unfeasible by manual means. It is therefore necessary to develop automatic tools that allow us to integrate this knowledge into a structure that is easy to use by both machines and humans. This paper presents T2KG, a framework that can incorporate the relevant information from several structured or unstructured documents into a semantic network. Structured documents are processed based on their annotation scheme. For unstructured documents, T2KG uses a set of Natural Language Processing sensors that identify relevant information to enrich the semantic network created by linking all the knowledge from different documents.<br/></div> © 2023 Incoma Ltd. All rights reserved.},
key = {Knowledge graph},
